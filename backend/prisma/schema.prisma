// CD-Recruit — Prisma Schema (Phase 1 final)
// Field naming: camelCase in Prisma models (matches packages/shared-types + API contract)
// mapped via @map to snake_case DB columns (standard Postgres convention).
// Table names mapped via @@map to snake_case as well.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "billing", "platform"]
}

// ---------- Enums ----------

enum ModuleType {
  MCQ
  SQL
  NOSQL
  CODING
  DEBUGGING
  AI_PROMPTING
  SIMULATION
  TEST_SCENARIOS

  @@schema("public")
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  DISCONNECTED
  AUTO_SUBMITTED
  SUBMITTED
  CLOSED
  ABANDONED

  @@schema("public")
}

enum CvMode {
  FULL
  REDUCED

  @@schema("public")
}

enum StaffRole {
  ADMIN
  HR_LEAD
  HR_ASSOCIATE
  REVIEWER
  RECRUITER

  @@schema("public")
}

enum DecisionType {
  ADVANCE
  REJECT

  @@schema("public")
}

enum OriginChannel {
  DIRECT
  PARTNER_API

  @@schema("public")
}

enum InviteStatus {
  PENDING
  REDEEMED
  EXPIRED
  REVOKED

  @@schema("public")
}

enum DriveStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED

  @@schema("public")
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("public")
}

enum SubmissionType {
  RUN
  SUBMIT

  @@schema("public")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIMEOUT
  MEMORY_LIMIT
  FAILED

  @@schema("public")
}

enum SqlExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  QUERY_ERROR
  TIMEOUT
  FAILED

  @@schema("public")
}

enum ConsentType {
  TERMS
  BIOMETRIC
  SELFIE
  AUDIO

  @@schema("public")
}

enum Department {
  SOFTWARE_ENGINEERING
  DATA_ENGINEERING
  PMO
  QA
  SYSOPS
  ITOPS
  SECOPS
  SRE

  @@schema("public")
}

enum CandidateCategory {
  FRESHER
  EXPERIENCED

  @@schema("public")
}

enum ExperienceLevel {
  FRESHER
  EXPERIENCED

  @@schema("public")
}

model RoleTemplate {
  id              String             @id @default(uuid())
  roleName        String             @map("role_name")
  weightingPreset Json               @map("weighting_preset")
  durationMinutes Int                @map("duration_minutes") // drives session.deadlineAt
  department      Department?        @map("department")
  level           ExperienceLevel?   @map("level")
  category        CandidateCategory? @map("category")
  experienceTier  String?            @map("experience_tier")
  version         Int                @default(1) @map("version")
  isActive        Boolean            @default(true) @map("is_active")

  sessions  Session[]
  invites   Invite[]
  drives    Drive[]
  questions RoleTemplateQuestion[]

  @@unique([department, category, experienceTier, version])
  @@map("role_template")
  @@schema("public")
}

model Drive {
  id             String      @id @default(uuid())
  organizationId String?     @map("organization_id")
  name           String
  roleTemplateId String      @map("role_template_id")
  moduleConfig   Json        @map("module_config")
  status         DriveStatus @default(DRAFT)
  scheduleStart  DateTime?   @map("schedule_start")
  scheduleEnd    DateTime?   @map("schedule_end")
  createdById    String      @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  bufferMinutes  Int         @default(15) @map("buffer_minutes")
  graceMinutes   Int         @default(5) @map("grace_minutes")
  slotDistribution Json?     @map("slot_distribution")
  originChannel  OriginChannel @default(DIRECT) @map("origin_channel")
  isEditingUnlocked Boolean   @default(false) @map("is_editing_unlocked")
  fallthrough    String        @default("ALLOW") @db.VarChar(16)

  organization   Organization? @relation(fields: [organizationId], references: [id])
  roleTemplate   RoleTemplate  @relation(fields: [roleTemplateId], references: [id])
  createdBy      Staff         @relation(fields: [createdById], references: [id])
  sessions       Session[]
  invites        Invite[]
  questions      DriveQuestion[]

  @@map("drive")
  @@schema("public")
}

model DriveQuestion {
  id                      String     @id @default(uuid())
  driveId                 String     @map("drive_id")
  questionId              String     @map("question_id")
  moduleType              ModuleType @map("module_type")
  questionVersionSnapshot Int?       @map("question_version_snapshot")
  pointShare              Float?     @map("point_share")

  drive    Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([driveId, questionId])
  @@map("drive_question")
  @@schema("public")
}

model RoleTemplateQuestion {
  id                      String     @id @default(uuid())
  roleTemplateId          String     @map("role_template_id")
  questionId              String     @map("question_id")
  moduleType              ModuleType @map("module_type")
  orderIndex              Int        @default(0) @map("order_index")
  questionVersionSnapshot Int?       @map("question_version_snapshot")
  pointShare              Float?     @map("point_share")

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, questionId])
  @@map("role_template_question")
  @@schema("public")
}

model Question {
  id             String     @id @default(uuid())
  moduleType     ModuleType @map("module_type")
  role           String?    @default("General")
  targetLevel    String?    @map("target_level")
  content        Json
  scoringConfig  Json?      @map("scoring_config")
  difficulty     String?
  tags           String[]
  folderId       String?    @map("folder_id")
  version        Int        @default(1)
  status         QuestionStatus @default(PUBLISHED)

  moduleResponses       ModuleResponse[]
  driveQuestions        DriveQuestion[]
  roleTemplateQuestions RoleTemplateQuestion[]
  codingExecutions      CodingExecution[]
  sqlExecutions         SQLExecution[]

  @@map("question")
  @@schema("public")
}

model Organization {
  id                       String   @id @default(uuid())
  name                     String
  slug                     String   @unique
  billingAccountId         String   @unique @map("billing_account_id")
  appealWindowDaysOverride Int?     @map("appeal_window_days_override")
  createdAt                DateTime @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  candidates     Candidate[]
  drives         Drive[]
  staff          Staff[]
  sessions       Session[]

  @@map("organization")
  @@schema("public")
}

model Candidate {
  id                         String        @id @default(uuid())
  organizationId             String?       @map("organization_id")
  email                      String        @unique
  name                       String
  idProofRef                 String?       @map("id_proof_ref")
  idProofEmbedding           Json?         @map("id_proof_embedding")
  idProofModel               String?       @map("id_proof_model")
  idProofExtractedName       String?       @map("id_proof_extracted_name")
  idProofOcrRaw              String?       @map("id_proof_ocr_raw")
  ocrConfidence              Float?        @map("ocr_confidence")
  idVerifiedAt               DateTime?     @map("id_verified_at")
  baselineSelfieEmbedding    Json?         @map("baseline_selfie_embedding")
  baselineSelfieRef          String?       @map("baseline_selfie_ref")
  identityVerificationResult Json?         @map("identity_verification_result")
  createdAt                  DateTime      @default(now()) @map("created_at")

  organization   Organization? @relation(fields: [organizationId], references: [id])
  sessions       Session[]
  consentRecords ConsentRecord[]

  @@map("candidate")
  @@schema("public")
}

model ConsentRecord {
  id           String      @id @default(uuid())
  candidateId  String      @map("candidate_id")
  consentType  ConsentType @map("consent_type")
  version      String
  consentedAt  DateTime    @default(now()) @map("consented_at")
  ipAddress    String      @map("ip_address")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("consent_record")
  @@schema("public")
}

model Session {
  id                         String        @id @default(uuid())
  organizationId             String?       @map("organization_id")
  candidateId                String        @map("candidate_id")
  roleTemplateId             String        @map("role_template_id")
  driveId                    String?       @map("drive_id")
  cvMode                     CvMode        @map("cv_mode")
  status                     SessionStatus @default(NOT_STARTED)
  kind                       String        @default("LIVE") @db.VarChar(16)
  baselineSelfieRef          String?       @map("baseline_selfie_ref")
  baselineSelfieEmbedding    Json?         @map("baseline_selfie_embedding")
  idProofRef                 String?       @map("id_proof_ref")
  idProofEmbedding           Json?         @map("id_proof_embedding")
  idVerifiedAt               DateTime?     @map("id_verified_at")
  identityVerificationResult Json?         @map("identity_verification_result")
  tutorialMode       String        @default("full") @map("tutorial_mode")
  actualStartAt      DateTime?     @map("actual_start_at")

  startedAt        DateTime? @map("started_at")
  deadlineAt        DateTime? @map("deadline_at")          // startedAt + roleTemplate.durationMinutes
  submittedAt       DateTime? @map("submitted_at")
  lastActivityAt    DateTime? @map("last_activity_at")
  lastHeartbeatAt   DateTime? @map("last_heartbeat_at")     // tab-alive signal, every 15s
  disconnectedAt    DateTime? @map("disconnected_at")       // set when heartbeat goes stale
  activeTabId       String?   @map("active_tab_id")         // single-active-session enforcement
  disconnectCount   Int       @default(0) @map("disconnect_count") // incremented on each DISCONNECTED event; AUTO_SUBMITTED when ≥ 3
  workspaceStatus   String?   @default("provisioning") @map("workspace_status")
  simulationSnapshot Json?    @map("simulation_snapshot")
  originChannel     OriginChannel @default(DIRECT) @map("origin_channel")
  referenceId       String?   @unique @map("reference_id")
  heldAt            DateTime? @map("held_at")
  holdReason        String?   @map("hold_reason") @db.VarChar(32)
  endReason         String?   @map("end_reason") @db.VarChar(32)

  organization Organization? @relation(fields: [organizationId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id])
  drive        Drive?       @relation(fields: [driveId], references: [id])

  moduleResponses   ModuleResponse[]
  eventLogs         EventLog[]
  integrityFlags    IntegrityFlag[]
  proctoringEvents  ProctoringEvent[]
  score             Score?
  reviewerDecision  ReviewerDecision?
  invite            Invite?
  codingExecutions  CodingExecution[]
  sqlExecutions     SQLExecution[]
  identityCaptures  IdentityCapture[]

  @@index([referenceId])
  @@index([candidateId])
  @@index([driveId])
  @@index([status])
  @@index([startedAt])
  @@index([submittedAt])
  @@index([deadlineAt])
  @@index([lastHeartbeatAt])
  @@map("session")
  @@schema("public")
}

model ModuleResponse {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  questionId        String   @map("question_id")
  responsePayload   Json     @map("response_payload")
  timeSpentSeconds  Int?     @map("time_spent_seconds")
  isDraft           Boolean  @default(true) @map("is_draft") // true until real submit overwrites it
  lastAutosavedAt   DateTime? @map("last_autosaved_at")
  sandboxDbName     String?  @map("sandbox_db_name")
  executionCount    Int      @default(0) @map("execution_count")
  lastOperation     Json?    @map("last_operation")

  session  Session  @relation(fields: [sessionId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("module_response")
  @@schema("public")
}

model EventLog {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  eventType  String   @map("event_type")
  // Proctoring events (PASTE, TAB_SWITCH, GAZE_DEVIATION, ...) plus session-integrity
  // events (HEARTBEAT_MISSED, DISCONNECTED, RECONNECTED, GRACE_WINDOW_EXPIRED,
  // AUTO_SUBMITTED, SECOND_TAB_DETECTED). Kept as string here for flexibility;
  // valid values are enforced via a shared enum in packages/shared-types.
  payload    Json
  occurredAt DateTime @default(now()) @map("occurred_at")

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([eventType])
  @@map("event_log")
  @@schema("public")
}

model IntegrityFlag {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  category   String
  confidence Float
  severity   String
  flaggedAt  DateTime @default(now()) @map("flagged_at")

  disposition     String?
  dispositionAt   DateTime? @map("disposition_at")
  dispositionById String?   @map("disposition_by_id")

  session      Session       @relation(fields: [sessionId], references: [id])
  evidenceClip EvidenceClip?

  @@index([sessionId])
  @@index([category])
  @@index([severity])
  @@map("integrity_flag")
  @@schema("public")
}

model EvidenceClip {
  id         String   @id @default(uuid())
  flagId     String   @unique @map("flag_id")
  storageRef String   @map("storage_ref")
  expiresAt  DateTime @map("expires_at")

  flag IntegrityFlag @relation(fields: [flagId], references: [id])

  @@map("evidence_clip")
  @@schema("public")
}

model Score {
  id                     String  @id @default(uuid())
  sessionId              String  @unique @map("session_id")
  compositeScore         Float   @map("composite_score")
  coreScore              Float?  @default(0) @map("core_score")
  bonusScore             Float?  @default(0) @map("bonus_score")
  totalScore             Float?  @default(0) @map("total_score")
  moduleScores           Json    @map("module_scores")
  sayDoConsistencyScore  Float?  @map("say_do_consistency_score")
  aiConfidence           Float?  @map("ai_confidence")
  humanReviewed          Boolean @default(false) @map("human_reviewed")
  sayDoRationale         String? @map("say_do_rationale")
  sayDoMismatches        Json?   @map("say_do_mismatches")
  gradingSource          String  @default("placeholder") @map("grading_source")

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([compositeScore])
  @@index([aiConfidence])
  @@map("score")
  @@schema("public")
}

model Staff {
  id               String    @id @default(uuid())
  organizationId   String?   @map("organization_id")
  email            String    @unique
  name             String
  role             StaffRole @default(RECRUITER)
  passwordHash          String?   @map("password_hash")
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")


  organization      Organization?    @relation(fields: [organizationId], references: [id])
  reviewerDecisions ReviewerDecision[]
  invites           Invite[]
  drives            Drive[]
  auditLogs         AuditLog[]

  @@map("staff")
  @@schema("public")
}

model ReviewerDecision {
  id         String       @id @default(uuid())
  sessionId  String       @unique @map("session_id")
  staffId    String       @map("staff_id") // renamed from reviewerId to match STAFF table
  decision   DecisionType
  decidedAt  DateTime     @default(now()) @map("decided_at")
  note       String?
  agreedWithAi Boolean?   @map("agreed_with_ai")

  session Session @relation(fields: [sessionId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@map("reviewer_decision")
  @@schema("public")
}

model Invite {
  id                String       @id @default(uuid())
  candidateEmail    String       @map("candidate_email")
  candidateName     String       @map("candidate_name")
  roleTemplateId    String       @map("role_template_id")
  driveId           String?      @map("drive_id")
  status            InviteStatus @default(PENDING)
  token             String       @unique
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  expiresAt         DateTime     @map("expires_at")
  redeemedAt        DateTime?    @map("redeemed_at")
  revokedAt         DateTime?    @map("revoked_at")
  sessionId         String?      @unique @map("session_id")
  isGenerated       Boolean      @default(false) @map("is_generated")
  scheduledTime     DateTime?    @map("scheduled_time")
  bufferMinutes     Int          @default(15) @map("buffer_minutes")
  graceMinutes      Int          @default(5) @map("grace_minutes")
  originChannel     OriginChannel @default(DIRECT) @map("origin_channel")
  idProofRef        String?      @map("id_proof_ref")
  idProofEmbedding  Json?        @map("id_proof_embedding")
  idProofUploadedAt DateTime?          @map("id_proof_uploaded_at")
  category          CandidateCategory? @map("category")
  experienceTier    String?            @map("experience_tier")

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id])
  createdBy    Staff        @relation(fields: [createdById], references: [id])
  session      Session?     @relation(fields: [sessionId], references: [id])
  drive        Drive?       @relation(fields: [driveId], references: [id])

  @@index([candidateEmail])
  @@index([status])
  @@map("invite")
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid())
  staffId    String   @map("staff_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json
  occurredAt DateTime @default(now()) @map("occurred_at")

  staff Staff @relation(fields: [staffId], references: [id])

  @@map("audit_log")
  @@schema("public")
}

model CodingExecution {
  id             String          @id @default(uuid())
  sessionId      String          @map("session_id")
  questionId     String          @map("question_id")
  languageId     Int             @map("language_id")
  submissionType SubmissionType  @map("submission_type")
  sourceCode        String          @map("source_code")
  judge0Token       String?         @map("judge0_token")
  judge0Tokens      Json?           @map("judge0_tokens")
  webhookReceivedAt DateTime?       @map("webhook_received_at")
  status            ExecutionStatus
  stdout         String?
  stderr         String?
  compileOutput  String?         @map("compile_output")
  passedTests    Int             @map("passed_tests")
  totalTests     Int             @map("total_tests")
  executionTime  Float?          @map("execution_time")
  memoryUsage    Int?            @map("memory_usage")
  createdAt      DateTime        @default(now()) @map("created_at")
  completedAt    DateTime?       @map("completed_at")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("coding_execution")
  @@schema("public")
}

model SQLExecution {
  id             String             @id @default(uuid())
  sessionId      String             @map("session_id")
  questionId     String             @map("question_id")
  submissionType SubmissionType     @map("submission_type")
  query          String
  status         SqlExecutionStatus
  resultJson     Json?              @map("result_json")
  passed         Boolean
  executionTime  Int?               @map("execution_time")
  createdAt      DateTime           @default(now()) @map("created_at")
  completedAt    DateTime?          @map("completed_at")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("sql_execution")
  @@schema("public")
}

enum ProctoringEventType {
  FACE_MISSING
  MULTIPLE_FACES
  LOOKING_AWAY
  SEAT_EXIT
  EXCESSIVE_MOVEMENT
  PHONE_DETECTED
  HEADPHONES_DETECTED
  BOOK_DETECTED
  SPEECH_DETECTED
  SECOND_VOICE_SUSPECTED
  IDENTITY_MISMATCH
  TAB_SWITCH
  PASTE
  FULLSCREEN_EXIT

  @@schema("public")
}

enum ProctoringUploadStatus {
  PENDING
  UPLOADED
  FAILED

  @@schema("public")
}

model ProctoringEvent {
  id           String                 @id @default(uuid())
  sessionId    String                 @map("session_id")
  eventType    ProctoringEventType    @map("event_type")
  severity     String                 @map("severity")
  timestamp    DateTime               @map("timestamp")
  clipUrl      String?                @map("clip_url")
  modelVersion String?                @map("model_version")
  uploadStatus ProctoringUploadStatus @default(PENDING) @map("upload_status")
  createdAt    DateTime               @default(now()) @map("created_at")

  session      Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("proctoring_event")
  @@schema("public")
}

model Partner {
  id           String   @id @default(uuid())
  name         String
  hashedApiKey String   @map("hashed_api_key")
  callbackUrl  String?  @map("callback_url")
  rateLimit    Int      @default(100) @map("rate_limit")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  apiHitCount  Int      @default(0) @map("api_hit_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("partner")
  @@schema("public")
}

model ModuleSetting {
  id         String     @id @default(uuid())
  department Department
  moduleType ModuleType @map("module_type")
  isEnabled  Boolean    @default(true) @map("is_enabled")

  @@unique([department, moduleType])
  @@map("module_setting")
  @@schema("public")
}

model IdentityCapture {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  windowIndex Int       @map("window_index")
  scheduledAt DateTime  @map("scheduled_at")
  capturedAt  DateTime? @map("captured_at")
  status      String    @default("PENDING")
  imageRef    String?   @map("image_ref")
  matched     Boolean?
  distance    Float?
  threshold   Float?
  verifiedAt  DateTime? @map("verified_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, windowIndex])
  @@index([sessionId])
  @@index([status])
  @@map("identity_capture")
  @@schema("public")
}

// ==========================================
// SCHEMA: billing (Commercial Ledger & Payer)
// ==========================================

model BillingAccount {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(255)
  legalEntityName String?   @map("legal_entity_name") @db.VarChar(255)
  billingCountry  String    @default("IN") @map("billing_country") @db.VarChar(2)
  currency        String    @default("INR") @db.VarChar(3)
  taxId           String?   @map("tax_id") @db.VarChar(64)
  status          String    @default("ACTIVE") @db.VarChar(32)
  overdraftLimit  Int       @default(0) @map("overdraft_limit")
  overdraftUsed   Int       @default(0) @map("overdraft_used")
  hasPaidPurchase Boolean   @default(false) @map("has_paid_purchase")
  trialDomain     String?   @unique @map("trial_domain") @db.VarChar(255)
  trialGrantedAt  DateTime? @map("trial_granted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @default(now()) @map("updated_at")

  organization          Organization?
  creditPools           CreditPool[]
  ledgerEntries         CreditLedgerEntry[]
  manualBillingRequests ManualBillingRequest[]
  payments              Payment[]

  @@index([status])
  @@map("billing_account")
  @@schema("billing")
}

model CreditPool {
  id              String    @id @default(uuid())
  billingAccountId String   @map("billing_account_id")
  driveId         String?   @map("drive_id")
  poolType        String    @map("pool_type") @db.VarChar(32)
  name            String    @db.VarChar(255)
  source          String    @db.VarChar(32)
  totalCredits    Int       @map("total_credits")
  cachedRemaining Int       @map("cached_remaining")
  validityDays    Int?      @map("validity_days")
  maxWaitDays     Int       @default(365) @map("max_wait_days")
  queueOrder      Int?      @map("queue_order")
  status          String    @default("QUEUED") @db.VarChar(32)
  purchasedAt     DateTime  @default(now()) @map("purchased_at")
  clockStartedAt  DateTime? @map("clock_started_at")
  activatedAt     DateTime? @map("activated_at")
  expiresAt       DateTime? @map("expires_at")
  unitPriceMinor  Int?      @map("unit_price_minor")
  currency        String?   @db.VarChar(3)
  paymentId       String?   @map("payment_id")
  termsVersion    String?   @map("terms_version") @db.VarChar(32)
  termsAcceptedBy String?   @map("terms_accepted_by") @db.VarChar(255)
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  payment        Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries  CreditLedgerEntry[]

  @@index([billingAccountId, status])
  @@index([expiresAt])
  @@map("credit_pool")
  @@schema("billing")
}

model CreditLedgerEntry {
  id               String    @id @default(uuid())
  billingAccountId String    @map("billing_account_id")
  organizationId   String    @map("organization_id")
  creditPoolId     String?   @map("credit_pool_id")
  entryType        String    @map("entry_type") @db.VarChar(32)
  amount           Int
  balanceAfter     Int?      @map("balance_after")
  sessionId        String?   @map("session_id")
  driveId          String?   @map("drive_id")
  relatedEntryId   String?   @map("related_entry_id")
  grantSource      String?   @map("grant_source") @db.VarChar(32)
  reason           String    @db.VarChar(64)
  reasonNote       String?   @map("reason_note") @db.VarChar(200)
  paymentId        String?   @map("payment_id")
  requestId        String?   @map("request_id")
  idempotencyKey   String    @unique @map("idempotency_key") @db.VarChar(128)
  actorId          String    @map("actor_id") @db.VarChar(128)
  approvedById     String?   @map("approved_by_id") @db.VarChar(128)
  shadow           Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount        @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  creditPool     CreditPool?           @relation(fields: [creditPoolId], references: [id], onDelete: Restrict)
  relatedEntry   CreditLedgerEntry?    @relation("LedgerEntryReversal", fields: [relatedEntryId], references: [id], onDelete: Restrict)
  reversedBy     CreditLedgerEntry[]   @relation("LedgerEntryReversal")
  payment        Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  request        ManualBillingRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([billingAccountId, createdAt])
  @@index([creditPoolId, createdAt])
  @@index([sessionId])
  @@index([driveId, entryType])
  @@map("credit_ledger_entry")
  @@schema("billing")
}

model Payment {
  id                String    @id @default(uuid())
  billingAccountId  String    @map("billing_account_id")
  provider          String    @db.VarChar(32)
  providerPaymentId String    @map("provider_payment_id") @db.VarChar(128)
  providerOrderId   String?   @map("provider_order_id") @db.VarChar(128)
  status            String    @db.VarChar(32)
  priceBookEntryId  String    @map("price_book_entry_id")
  quantityCredits   Int       @map("quantity_credits")
  unitPriceMinor    Int       @map("unit_price_minor")
  amountMinor       Int       @map("amount_minor")
  taxMinor          Int?      @map("tax_minor")
  currency          String    @db.VarChar(3)
  invoiceNumber     String?   @map("invoice_number") @db.VarChar(64)
  capturedAt        DateTime? @map("captured_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  priceBookEntry PriceBookEntry      @relation(fields: [priceBookEntryId], references: [id], onDelete: Restrict)
  creditPools    CreditPool[]
  ledgerEntries  CreditLedgerEntry[]

  @@unique([provider, providerPaymentId])
  @@index([billingAccountId, createdAt])
  @@map("payment")
  @@schema("billing")
}

model ManualBillingRequest {
  id               String    @id @default(uuid())
  billingAccountId String    @map("billing_account_id")
  kind             String    @db.VarChar(32)
  payload          Json
  reason           String
  ticketRef        String    @map("ticket_ref") @db.VarChar(64)
  requestedById    String    @map("requested_by_id") @db.VarChar(128)
  approvedById     String?   @map("approved_by_id") @db.VarChar(128)
  status           String    @default("PENDING") @db.VarChar(32)
  rejectionReason  String?   @map("rejection_reason")
  executionError   String?   @map("execution_error")
  decidedAt        DateTime? @map("decided_at")
  executedAt       DateTime? @map("executed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  ledgerEntries  CreditLedgerEntry[]

  @@index([billingAccountId, status])
  @@index([status, createdAt])
  @@map("manual_billing_request")
  @@schema("billing")
}

model PriceBookEntry {
  id             String    @id @default(uuid())
  sku            String    @db.VarChar(64)
  poolType       String    @map("pool_type") @db.VarChar(32)
  credits        Int
  validityDays   Int?      @map("validity_days")
  billingCountry String    @map("billing_country") @db.VarChar(2)
  currency       String    @db.VarChar(3)
  unitPriceMinor Int       @map("unit_price_minor")
  version        Int       @default(1)
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")

  payments Payment[]

  @@unique([sku, billingCountry, version])
  @@map("price_book_entry")
  @@schema("billing")
}

model BillingAuditEvent {
  id                   String   @id @default(uuid())
  timestamp            DateTime @default(now())
  actorId              String   @map("actor_id") @db.VarChar(128)
  actorRole            String   @map("actor_role") @db.VarChar(32)
  subjectType          String   @map("subject_type") @db.VarChar(32)
  subjectId            String   @map("subject_id")
  action               String   @db.VarChar(64)
  before               Json?
  after                Json?
  reason               String?
  ticketRef            String?  @map("ticket_ref") @db.VarChar(64)
  impersonationContext Json?    @map("impersonation_context")
  requestId            String?  @map("request_id")
  executionResult      String   @map("execution_result") @db.VarChar(16)

  @@index([subjectType, subjectId])
  @@index([timestamp])
  @@map("billing_audit_event")
  @@schema("billing")
}

model SessionBillingEvidence {
  sessionId              String    @id @map("session_id")
  billingAccountId       String    @map("billing_account_id")
  driveId                String?   @map("drive_id")
  kind                   String?   @db.VarChar(16)
  startedAt              DateTime? @map("started_at")
  firstContentRenderedAt DateTime? @map("first_content_rendered_at")
  lastHeartbeatAt        DateTime? @map("last_heartbeat_at")
  endedAt                DateTime? @map("ended_at")
  endReason              String?   @map("end_reason") @db.VarChar(32)
  eventCount             Int       @default(0) @map("event_count")
  modulesReached         Int       @default(0) @map("modules_reached")
  cvMode                 String?   @map("cv_mode") @db.VarChar(32)
  infraFlags             Json?     @map("infra_flags")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([billingAccountId])
  @@index([driveId])
  @@map("session_billing_evidence")
  @@schema("billing")
}

model PaymentWebhookInbox {
  id           String    @id @default(uuid())
  provider     String    @db.VarChar(32)
  eventId      String    @map("event_id") @db.VarChar(128)
  eventType    String    @map("event_type") @db.VarChar(64)
  payload      Json
  status       String    @default("PENDING") @db.VarChar(32)
  errorMessage String?   @map("error_message")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@map("payment_event")
  @@schema("billing")
}

model ReconciliationRun {
  id                 String    @id @default(uuid())
  runType            String    @map("run_type") @db.VarChar(32)
  status             String    @db.VarChar(32)
  checkResults       Json      @map("check_results")
  driftDetected      Boolean   @default(false) @map("drift_detected")
  discrepancyDetails Json?     @map("discrepancy_details")
  executedBy         String    @map("executed_by") @db.VarChar(128)
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("reconciliation_run")
  @@schema("billing")
}

// ==========================================
// SCHEMA: platform (Internal Operations)
// ==========================================

model PlatformStaff {
  id                  String    @id @default(uuid())
  email               String    @unique @db.VarChar(255)
  name                String    @db.VarChar(255)
  role                String    @default("SUPPORT") @db.VarChar(32)
  passwordHash        String?   @map("password_hash")
  refreshTokenHash    String?   @map("refresh_token_hash")
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  mfaEnabled          Boolean   @default(true) @map("mfa_enabled")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("platform_staff")
  @@schema("platform")
}

model SystemAuditEvent {
  id                   String   @id @default(uuid())
  timestamp            DateTime @default(now())
  actorId              String   @map("actor_id") @db.VarChar(128)
  actorRole            String   @map("actor_role") @db.VarChar(32)
  subjectType          String   @map("subject_type") @db.VarChar(32)
  subjectId            String   @map("subject_id")
  action               String   @db.VarChar(64)
  before               Json?
  after                Json?
  reason               String?
  ticketRef            String?  @map("ticket_ref") @db.VarChar(64)
  impersonationContext Json?    @map("impersonation_context")
  requestId            String?  @map("request_id")
  executionResult      String   @map("execution_result") @db.VarChar(16)

  @@index([subjectType, subjectId])
  @@index([timestamp])
  @@map("platform_audit_event")
  @@schema("platform")
}

model IncidentWindow {
  id             String    @id @default(uuid())
  title          String    @db.VarChar(255)
  reason         String
  ticketRef      String    @map("ticket_ref") @db.VarChar(64)
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")
  affectedDrives String[]  @map("affected_drives")
  reversalStatus String    @default("PENDING") @map("reversal_status") @db.VarChar(32)
  createdBy      String    @map("created_by") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([startedAt, endedAt])
  @@map("incident_window")
  @@schema("platform")
}
