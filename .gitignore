# ─────────────────────────────────────────────
# CD-Recruit — .gitignore
# ─────────────────────────────────────────────

# ── Environment / secrets ─────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Node ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build artefacts ───────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
*.tsbuildinfo

# ── Vite ──────────────────────────────────────
.vite/

# ── TypeScript ────────────────────────────────
*.js.map
*.d.ts.map

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
.venv/
venv/
env/
.Python
*.egg-info/
dist/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Prisma ────────────────────────────────────
# Keep migrations and schema; ignore generated client
backend/prisma/generated/

# ── Docker ────────────────────────────────────
docker-compose.override.yml

# ── IDE / OS ──────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Test coverage ─────────────────────────────
coverage/
lcov.info

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── MinIO local data ──────────────────────────
.minio-data/

# ── Misc ──────────────────────────────────────
*.local
.turbo/

# ── Redis ─────────────────────────────────────
dump.rdb
/dump.rdb
