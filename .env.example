# ── Object Storage (MinIO or AWS S3) ─────────────────────────────────────────
# The storage client natively supports both MinIO and AWS S3 via S3 protocol.
#
# Mode A: Local Staging / Containerized MinIO:
# ── Code Execution (Judge0) ───────────────────
# Hosted Judge0 API base URL (use https://judge0-ce.p.rapidapi.com for cloud)
JUDGE0_API_URL=http://localhost:2358
# RapidAPI key — leave blank if using self-hosted Judge0
JUDGE0_API_KEY=
# Execution operational timeouts and retries
JUDGE0_CPU_TIME_LIMIT=5.0
JUDGE0_WALL_TIME_LIMIT=10.0
JUDGE0_MAX_RETRY_ATTEMPTS=3
JUDGE0_RETRY_BASE_DELAY_MS=500

# ── Circuit Breaker (Opossum) ────────────────
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5

# ── AI / Groq & Anthropic ────────────────────
GROQ_API_KEY=
# API key for Claude (used by correlation-engine for grading)
ANTHROPIC_API_KEY=sk-ant-changeme


# ── Object Storage (MinIO) ───────────────────
# 'local' uses a no-op fake storage provider — dev-only, never use in staging/prod
INFRA_MODE=full
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_GENERAL=cd-recruit-general
MINIO_BUCKET_BIOMETRIC=cd-recruit-biometric
#
# Mode B: Production AWS S3 Cutover (Uncomment for AWS S3):
# MINIO_ENDPOINT=s3.ap-south-1.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=ap-south-1
# MINIO_ACCESS_KEY=AKIA...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET_GENERAL=cdrecruit-prod-general
# MINIO_BUCKET_BIOMETRIC=cdrecruit-prod-biometric

