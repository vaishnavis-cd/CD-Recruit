# ─────────────────────────────────────────────────────────────────────────────
# CD-Recruit — Environment Variables Template
#
# USAGE:
#   1. Local Dev: Copy this file to .env and adjust credentials if needed.
#      cp .env.example .env
#      cp .env backend/api/.env
#   2. Cloud Deployment (AWS S3 / RDS): Follow inline comments to point to
#      AWS RDS PostgreSQL and AWS S3 object storage seamlessly.
#
# NEVER COMMIT .env — It is strictly excluded in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime & Infrastructure Mode ────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# Infrastructure Mode:
#   - "local": Runs without local container dependencies using mock in-memory
#              storage & schedulers (ideal for rapid UI development).
#   - "full":  Connects to real local containers or cloud services
#              (PostgreSQL, Redis, MinIO/S3, MongoDB, Judge0, Face Verify).
INFRA_MODE=local

# Allowed CORS origins (Admin Web, Candidate Web, ATS Partner)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8000

# ── Primary Database (PostgreSQL / AWS RDS) ──────────────────────────────────
# Local Docker Compose maps Postgres to host port 5434:
DATABASE_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit

# For AWS RDS PostgreSQL Deployment:
# DATABASE_URL=postgresql://cdrecruit_admin:STRONG_PASSWORD@rds-endpoint.amazonaws.com:5432/cdrecruit?sslmode=require

# ── SQL Sandbox Database (Security Isolation) ────────────────────────────────
# In production, candidates executing SQL queries must run against an isolated
# database user with restricted permissions:
SANDBOX_DB_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit

# ── NoSQL Database (MongoDB — Interactive Assessment Module) ─────────────────
# Local Docker Compose maps MongoDB to port 27017:
MONGODB_URL=mongodb://admin:adminpassword@localhost:27017/admin

# ── Redis / BullMQ (Queues & Session Cache) ──────────────────────────────────
# Local Docker Compose maps Redis to host port 6379:
REDIS_URL=redis://localhost:6379

# ── Object Storage (MinIO or AWS S3) ─────────────────────────────────────────
# The storage client natively supports both MinIO and AWS S3 via standard S3 protocol.
#
# Mode A: Local Staging / Containerized MinIO:
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_GENERAL=cd-recruit-general
MINIO_BUCKET_BIOMETRIC=cd-recruit-biometric
#
# Mode B: Production AWS S3 Cutover (Uncomment for AWS S3):
# MINIO_ENDPOINT=s3.ap-south-1.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=ap-south-1
# MINIO_ACCESS_KEY=AKIA...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET_GENERAL=cdrecruit-prod-general
# MINIO_BUCKET_BIOMETRIC=cdrecruit-prod-biometric

# ── Staff Authentication (In-House Native JWT) ───────────────────────────────
# Native Staff auth uses crypto.scrypt password hashing & HS256 JWT tokens.
# Secret key must be at least 32 characters long.
JWT_SECRET=super-secret-jwt-key-for-staff-dev-2026-min32chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ── Candidate Assessment Session Authentication (Isolated) ───────────────────
# Separate tamper-proof secret for candidate invite tokens and session authentication.
CANDIDATE_JWT_SECRET=candidate-session-secret-key-32chars-min!
INVITE_TOKEN_TTL_HOURS=48

# ── Code Execution Engine (Judge0 CE) ────────────────────────────────────────
# Local self-hosted Judge0 CE sandbox URL (Port 2358)
JUDGE0_API_URL=http://localhost:2358
# Leave blank for self-hosted Judge0. Enter RapidAPI key if using hosted cloud Judge0:
JUDGE0_API_KEY=
# Execution operational timeouts and retries
JUDGE0_CPU_TIME_LIMIT=5.0
JUDGE0_WALL_TIME_LIMIT=10.0
JUDGE0_MAX_RETRY_ATTEMPTS=3
JUDGE0_RETRY_BASE_DELAY_MS=500

# ── Circuit Breaker (Opossum) ────────────────────────────────────────────────
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5

# ── Face Verification Microservice (Python FastAPI + DeepFace) ───────────────
# Local container runs on host port 8001
FACE_VERIFY_SERVICE_URL=http://localhost:8001

# ── Correlation Engine (In-Process NestJS Module) ────────────────────────────
# Runs in-process inside NestJS API (Port 3001).
CORRELATION_ENGINE_URL=http://localhost:3001
CORRELATION_ENGINE_API_KEY=changeme

# ── External AI Inference & Grading ──────────────────────────────────────────
# Claude API Key for multi-signal evaluation
ANTHROPIC_API_KEY=sk-ant-changeme
# Groq API Key for fast inference
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ── Session Integrity, Heartbeat & Telemetry Limits ──────────────────────────
EVIDENCE_CLIP_URL_TTL_SECONDS=300
EVIDENCE_CLIP_RETENTION_DAYS=90
HEARTBEAT_STALE_THRESHOLD_SECONDS=45
GRACE_WINDOW_SECONDS=300
MAX_DISCONNECT_COUNT=3
KYC_MODE=diy
FAKE_EVIDENCE_URL=

# ── Frontend Injected URLs (Vite) ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001
