# ─────────────────────────────────────────────────────────────────────────────
# CD-Recruit — Environment Variables Template
#
# USAGE:
#   1. Local Dev: Copy this file to .env and adjust credentials if needed.
#   2. Cloud Deployment (AWS S3 / RDS): Follow the inline comments to point to
#      AWS RDS PostgreSQL and AWS S3 object storage seamlessly.
#
# NEVER COMMIT .env — It is strictly excluded in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime & Infrastructure Mode ────────────────────────────────────────────
NODE_ENV=development
# Choose "local" for zero-dependency local mocks, or "full" for real containers / cloud
INFRA_MODE=local
API_PORT=3001

# ── Primary Database (PostgreSQL / AWS RDS) ──────────────────────────────────
# Local Docker Compose maps Postgres to host port 5434:
DATABASE_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit
#
# For AWS RDS PostgreSQL Deployment:
# DATABASE_URL=postgresql://cdrecruit_admin:STRONG_PASSWORD@rds-endpoint.amazonaws.com:5432/cdrecruit?sslmode=require

# ── SQL Sandbox Database (Security Isolation) ────────────────────────────────
# In production, candidates executing SQL queries must run against an isolated
# database user with restricted permissions:
SANDBOX_DB_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit

# ── Redis / BullMQ (Queues & Session Cache) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NoSQL Database (MongoDB — Interactive Assessment Module) ─────────────────
MONGODB_URL=mongodb://admin:adminpassword@localhost:27017/admin

# ── Object Storage (MinIO or AWS S3) ─────────────────────────────────────────
# The storage client natively supports both MinIO and AWS S3 via S3 protocol.
#
# Mode A: Local Staging / Containerized MinIO:
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_GENERAL=cd-recruit-general
MINIO_BUCKET_BIOMETRIC=cd-recruit-biometric
#
# Mode B: Production AWS S3 Cutover (Uncomment for AWS S3):
# MINIO_ENDPOINT=s3.ap-south-1.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=ap-south-1
# MINIO_ACCESS_KEY=AKIA...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET_GENERAL=cdrecruit-prod-general
# MINIO_BUCKET_BIOMETRIC=cdrecruit-prod-biometric

# ── Authentication & Security ────────────────────────────────────────────────
# Candidate Invite Token Secret
JWT_SECRET=changeme-use-a-long-random-string-at-least-32-chars
INVITE_TOKEN_TTL_HOURS=48

# Admin Staff Authentication (Native JWT Cutover - In 2 Days)
# These will replace Keycloak for Admin Panel authentication:
JWT_ACCESS_SECRET=changeme-use-a-long-random-access-secret
JWT_REFRESH_SECRET=changeme-use-a-long-random-refresh-secret

# ── Keycloak (Deprecated — Slated for removal in 2 days) ──────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cd-recruit
KEYCLOAK_CLIENT_ID=cd-recruit-api
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_USER=admin

# ── Code Execution Engine (Judge0) ───────────────────────────────────────────
# Self-hosted Judge0 CE sandbox URL (Port 2358)
JUDGE0_API_URL=http://localhost:2358
# Leave blank for self-hosted Judge0
JUDGE0_API_KEY=

# ── Face Verification Microservice (Python FastAPI + DeepFace) ───────────────
FACE_VERIFY_SERVICE_URL=http://localhost:8001

# ── External AI Inference & Grading ──────────────────────────────────────────
# Claude API Key for multi-signal simulation grading
ANTHROPIC_API_KEY=sk-ant-changeme
# Groq API Key for fast evaluation
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ── Network, CORS & Observability ────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:5173,http://localhost:8000
# Optional Sentry DSN for error reporting
SENTRY_DSN=

# ── Frontend Injected URLs (Vite) ────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=cd-recruit
VITE_KEYCLOAK_CLIENT_ID=cd-recruit-frontend

# ── Session Integrity & Heartbeat Limits ─────────────────────────────────────
EVIDENCE_CLIP_URL_TTL_SECONDS=300
EVIDENCE_CLIP_RETENTION_DAYS=90
HEARTBEAT_STALE_THRESHOLD_SECONDS=45
GRACE_WINDOW_SECONDS=300
MAX_DISCONNECT_COUNT=3
KYC_MODE=diy
FAKE_EVIDENCE_URL=
