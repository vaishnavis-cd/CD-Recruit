# ─────────────────────────────────────────────
# CD-Recruit — Environment Variables Reference
# Copy to .env and fill in real values before running anything locally.
# Never commit .env — it is in .gitignore.
# ─────────────────────────────────────────────

# ── Database ─────────────────────────────────
# Postgres connection string for Prisma
DATABASE_URL=postgresql://cdrecruit:cdrecruit123@localhost:5433/cdrecruit

# ── Redis / BullMQ ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Keycloak ─────────────────────────────────
# Base URL of your Keycloak instance (no trailing slash)
KEYCLOAK_URL=http://localhost:8085
# Realm name configured in Keycloak for this application
KEYCLOAK_REALM=cd-recruit
# OAuth2 client id registered in the realm (NestJS backend client)
KEYCLOAK_CLIENT_ID=cd-recruit-api
# Client secret from Keycloak → Clients → Credentials tab
KEYCLOAK_CLIENT_SECRET=changeme
# Admin service-account credentials (for realm management calls)
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=changeme

# ── Code Execution (Judge0) ───────────────────
# Hosted Judge0 API base URL (use https://judge0-ce.p.rapidapi.com for cloud)
JUDGE0_API_URL=http://localhost:2358
# RapidAPI key — leave blank if using self-hosted Judge0
JUDGE0_API_KEY=

# ── AI / Anthropic ────────────────────────────
# API key for Claude (used by correlation-engine for grading)
ANTHROPIC_API_KEY=sk-ant-changeme

# ── Object Storage (MinIO) ───────────────────
# 'local' uses a no-op fake storage provider — dev-only, never use in staging/prod
INFRA_MODE=full
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# General-purpose bucket (code submissions, non-biometric artefacts)
MINIO_BUCKET_GENERAL=cd-recruit-general
# Biometric-tier bucket — separate IAM boundary, envelope-encrypted
MINIO_BUCKET_BIOMETRIC=cd-recruit-biometric

# ── NestJS API ───────────────────────────────
NODE_ENV=development
API_PORT=3001
# JWT secret used for invite-token signing (not Keycloak JWTs)
JWT_SECRET=changeme-use-a-long-random-string
# How long an invite token stays valid
INVITE_TOKEN_TTL_HOURS=48

# ── Correlation Engine (FastAPI) ─────────────
CORRELATION_ENGINE_URL=http://localhost:8000
CORRELATION_ENGINE_API_KEY=changeme

# ── Frontend ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=cd-recruit
VITE_KEYCLOAK_CLIENT_ID=cd-recruit-frontend

# ── Email (Resend / Postmark free tier) ──────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_changeme

# ── Security ─────────────────────────────────
# Short-TTL (seconds) for MinIO signed evidence URLs served to reviewers
EVIDENCE_CLIP_URL_TTL_SECONDS=300
# Days until evidence clips are eligible for lifecycle deletion
EVIDENCE_CLIP_RETENTION_DAYS=90

# ── Heartbeat / Session Integrity ────────────
# How long (seconds) without a heartbeat before a session is marked DISCONNECTED.
# Must be > (frontend heartbeat interval × 2). Default: 45 s (3 × 15 s cycles).
# See docs/DECISIONS.md Decision 7 before changing this.
HEARTBEAT_STALE_THRESHOLD_SECONDS=45

# How long (seconds) a DISCONNECTED session stays resumable after disconnectedAt.
# After this window, the BullMQ scheduler AUTO_SUBMITs the session.
# Default: 300 s (5 minutes). See docs/DECISIONS.md Decision 7.
GRACE_WINDOW_SECONDS=300

# Maximum number of disconnects allowed before the session is AUTO_SUBMITTED
# immediately on the next disconnect (regardless of grace window).
# Default: 3. See docs/DECISIONS.md Decision 7.
MAX_DISCONNECT_COUNT=3

# ── Feature Flags ────────────────────────────
# Set to "paid" to switch to a KYC vendor instead of DIY liveness
KYC_MODE=diy

# ── Infrastructure Mode ───────────────────────
# Choose "local" for zero-dependency local development, or "full" for complete container suite
INFRA_MODE=local
# Optional placeholder evidence clip video URL returned by fake storage service in local mode
FAKE_EVIDENCE_URL=

