# ─────────────────────────────────────────────────────────────────────────────
# CD-Recruit — Environment Variables Template
#
# USAGE:
#   1. Local Dev: Copy this file to .env and adjust credentials if needed.
#   2. Cloud Deployment (AWS S3 / RDS): Follow the inline comments to point to
#      AWS RDS PostgreSQL and AWS S3 object storage seamlessly.
#
# NEVER COMMIT .env — It is strictly excluded in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime & Infrastructure Mode ────────────────────────────────────────────
NODE_ENV=development
# Choose "local" for zero-dependency local mocks, or "full" for real containers / cloud
INFRA_MODE=local
API_PORT=3001

# ── Primary Database (PostgreSQL / AWS RDS) ──────────────────────────────────
# Local Docker Compose maps Postgres to host port 5434:
DATABASE_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit
#
# For AWS RDS PostgreSQL Deployment:
# DATABASE_URL=postgresql://cdrecruit_admin:STRONG_PASSWORD@rds-endpoint.amazonaws.com:5432/cdrecruit?sslmode=require

# ── SQL Sandbox Database (Security Isolation) ────────────────────────────────
# In production, candidates executing SQL queries must run against an isolated
# database user with restricted permissions:
SANDBOX_DB_URL=postgresql://cdrecruit:cdrecruit123@localhost:5434/cdrecruit

# ── Redis / BullMQ (Queues & Session Cache) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

