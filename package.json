{
  "name": "cd-recruit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/candidate-web",
    "frontend/admin-web",
    "backend/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:candidate": "npm --workspace=frontend/candidate-web run dev",
    "dev:admin": "npm --workspace=frontend/admin-web run dev",
    "dev:api": "npm --workspace=backend/api run start:dev",
    "build": "npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "prepare": "husky",
    "db:generate": "npm --workspace=backend/api run prisma:generate",
    "db:migrate": "npm --workspace=backend/api run prisma:migrate",
    "db:seed": "npm --workspace=backend/api run prisma:seed",
    "db:studio": "npm --workspace=backend/api run prisma:studio"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "black"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
