{
  "name": "cd-recruit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/candidate-web",
    "frontend/admin-web",
    "frontend/super-admin-web",
    "backend/api",
    "packages/shared-types",
    "packages/design-tokens"
  ],
  "scripts": {
    "build:shared": "npm --workspace=packages/shared-types run build && npm --workspace=packages/design-tokens run build",
    "prepare": "npm run build:shared",
    "postinstall": "npm run build:shared",
    "infra:up": "docker compose -f docker/docker-compose.dev.yml -f docker/docker-compose.judge0.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.dev.yml -f docker/docker-compose.judge0.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.dev.yml -f docker/docker-compose.judge0.yml logs -f",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup:all": "npm run build:shared && npm run db:migrate && npm run db:seed",
    "ports:free": "node scripts/free-ports.js",
    "predev:candidate": "node scripts/free-ports.js 3000",
    "setup:super-admin": "npx tsx backend/prisma/scripts/setup-super-admin.ts",
    "dev:candidate": "npm run build:shared && npm --workspace=frontend/candidate-web run dev",
    "predev:admin": "node scripts/free-ports.js 5173",
    "dev:admin": "npm run build:shared && npm --workspace=frontend/admin-web run dev",
    "predev:api": "node scripts/free-ports.js 3001",
    "dev:super-admin": "npm run build:shared && npm --workspace=frontend/super-admin-web run dev",
    "dev:api": "npm run build:shared && npm --workspace=backend/api run start:dev",
    "build": "npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "test:unit": "npm --workspace=backend/api run test",
    "test:load": "k6 run ./k6/scripts/judge0_load_test.js",
    "test:all": "npm-run-all --parallel test:unit test:api test:load",
    "db:generate": "npm --workspace=backend/api run prisma:generate",
    "db:migrate": "npm --workspace=backend/api run prisma:migrate",
    "db:seed": "npm --workspace=backend/api run prisma:seed",
    "db:studio": "npm --workspace=backend/api run prisma:studio",
    "generate:drive": "npx tsx backend/prisma/generate-drive-and-invites.ts",
    "questions:validate": "npx tsx backend/prisma/scripts/validate-question-bank.ts",
    "questions:replace": "npx tsx backend/prisma/scripts/replace-question-bank.ts",
    "docs:sync": "node scripts/sync-manual-to-storage.js"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/testing": "^11.1.28",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "mocha": "^10.5.0",
    "prettier": "^3.9.5",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "typescript-eslint": "^8.64.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "allowScripts": {
    "@nestjs/core@11.1.28": true,
    "@scarf/scarf@1.4.0": true
  }
}